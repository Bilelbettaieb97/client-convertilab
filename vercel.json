{
  "crons": [
    {
      "path": "/api/cron/send-emails",
      "schedule": "0 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "convertilab.com" }],
      "destination": "https://www.convertilab.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "convertilab.fr" }],
      "destination": "https://www.convertilab.fr/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "src/app/api/seo-check/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/speed-check/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/design-score/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/estimateur-ads/route.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "src/app/api/pricing-calculator/route.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "src/app/api/mentions-legales/route.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "src/app/api/robots-generator/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/rapport-sectoriel/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/comparateur-sites/route.ts": {
      "memory": 1024,
      "maxDuration": 120
    },
    "src/app/api/chatbot-audit/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
